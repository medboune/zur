DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Admin console (/admin) ─ change before launch ───────────────────────────
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=generate-a-random-hex-string-here

# Demo listings visible in this preview. Set to "false" at launch to run
# the site in request-driven mode (no listings until real stock is approved).
SHOW_SAMPLE_LISTINGS=true

# ── Team email notifications (Resend) ────────────────────────────────────────
# Requests are ALWAYS saved to the database and visible in /admin.
# To also receive an email at info@zuronix.com within seconds:
#   1. Create a free account at resend.com and verify the zuronix.com domain
#   2. Paste the API key (starts with re_) into RESEND_API_KEY below
#   3. Set NOTIFY_EMAIL_FROM to a verified sender, e.g.
#      NOTIFY_EMAIL_FROM="Zuronix Website <website@zuronix.com>"
# Leave the key empty to disable email — nothing else changes.
RESEND_API_KEY=
NOTIFY_EMAIL_TO="Zuronix Team <info@zuronix.com>"
NOTIFY_EMAIL_FROM="Zuronix Website <onboarding@resend.dev>"
APP_URL=http://localhost:3000

# ── Customer acknowledgment email (prepared, OFF by default) ────────────────
# When ON, every customer automatically receives a professional confirmation
# email with their reference number. Requires a VERIFIED zuronix.com domain
# in Resend (it is sent from your own address). Flip to "true" when ready.
AUTO_ACK_EMAIL_ENABLED=false
ACK_EMAIL_FROM="Zuronix <info@zuronix.com>"
